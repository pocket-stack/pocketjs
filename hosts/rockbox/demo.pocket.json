{
  "$schema": "https://pocketjs.dev/schema/pocket-2.json",
  "pocket": 2,
  "id": "dev.pocket-stack.rockbox-ipod-classic",
  "name": "pocketjs-rockbox-ipod-classic",
  "title": "PocketJS — iPod classic",
  "version": "0.1.0",
  "engine": {
    "capabilities": {
      "requires": ["input.buttons", "text.glyphs.baked"]
    }
  },
  "app": {
    "entry": "hosts/rockbox/demo/main.tsx",
    "output": "rockbox-ipod-classic-demo",
    "framework": "solid",
    "viewport": {
      "fixed": {
        "logical": [320, 240],
        "presentation": "native"
      }
    }
  }
}
