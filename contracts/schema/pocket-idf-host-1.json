{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocketjs.dev/schema/pocket-idf-host-1.json",
  "title": "PocketJS ESP-IDF host profile, format 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "version",
    "id",
    "platform",
    "form",
    "tickHz",
    "display",
    "capabilities"
  ],
  "properties": {
    "$schema": {
      "const": "https://pocketjs.dev/schema/pocket-idf-host-1.json"
    },
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 15,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "platform": {
      "const": "esp-idf"
    },
    "form": {
      "enum": [
        "takeover",
        "kiosk",
        "embedded"
      ]
    },
    "tickHz": {
      "type": "integer",
      "minimum": 1,
      "maximum": 240
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "physicalViewport",
        "logicalViewports",
        "presentations",
        "rasterDensity"
      ],
      "properties": {
        "physicalViewport": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "minItems": 2,
          "maxItems": 2
        },
        "logicalViewports": {
          "type": "array",
          "description": "Touch-capable profiles are additionally limited to 512x512 logical coordinates.",
          "items": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "minItems": 2,
            "maxItems": 2
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "presentations": {
          "type": "array",
          "items": {
            "enum": [
              "fill",
              "fit",
              "integer-fit",
              "native",
              "stretch"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "rasterDensity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 255
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "enum": [
          "input.analog.left",
          "input.buttons",
          "input.cursor",
          "input.touch",
          "text.glyphs.baked"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    }
  }
}
