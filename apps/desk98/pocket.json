{
  "$schema": "https://pocketjs.dev/schema/pocket-2.json",
  "pocket": 2,
  "id": "dev.pocket-stack.desk98",
  "name": "pocket-desk98",
  "title": "PocketJS 98",
  "version": "0.1.0",
  "engine": {
    "capabilities": {
      "requires": [
        "text.glyphs.baked",
        "input.buttons"
      ],
      "enhances": [
        "input.text",
        "input.pointer",
        "input.ime",
        "host.clipboard",
        "display.viewport.live"
      ]
    }
  },
  "app": {
    "entry": "apps/desk98/main.ts",
    "output": "desk98-main",
    "framework": "vue-vapor",
    "companions": [
      "desk"
    ],
    "viewport": {
      "dynamic": {
        "default": [
          800,
          600
        ],
        "min": [
          640,
          480
        ]
      }
    }
  }
}
