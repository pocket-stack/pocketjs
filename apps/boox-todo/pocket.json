{
  "$schema": "https://pocketjs.dev/schema/pocket-2.json",
  "pocket": 2,
  "id": "dev.pocket-stack.boox-todo",
  "name": "pocketjs-boox-todo",
  "title": "Pocket Todo",
  "version": "0.1.0",
  "engine": {
    "capabilities": {
      "requires": ["input.touch", "text.glyphs.baked"]
    }
  },
  "app": {
    "entry": "apps/boox-todo/main.tsx",
    "output": "boox-todo-main",
    "framework": "vue-vapor",
    "viewport": {
      "fixed": {
        "logical": [320, 480],
        "presentation": "stretch"
      }
    }
  }
}
