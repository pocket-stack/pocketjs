# Pocket Remote daemon — a systemd user unit for the Omarchy machine.
# Installed by `bun tools/pocket-remote.ts deploy-host <ssh host>` into
# ~/.config/systemd/user/, next to the daemon copy in ~/.local/share/pocket-remote.
#
# The user manager already carries the graphical session's environment under
# Omarchy (uwsm imports WAYLAND_DISPLAY, HYPRLAND_INSTANCE_SIGNATURE, OMARCHY_PATH
# and the mise shims into it), which is what hyprland-dialog, wtype and the
# omarchy-* scripts need.

[Unit]
Description=Pocket Remote — Omarchy companion daemon
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/share/mise/shims/node %h/.local/share/pocket-remote/host/serve.ts
Restart=on-failure
RestartSec=2
Environment=NODE_NO_WARNINGS=1

[Install]
WantedBy=graphical-session.target
