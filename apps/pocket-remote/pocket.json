{
  "$schema": "https://pocketjs.dev/schema/pocket-2.json",
  "pocket": 2,
  "id": "dev.pocket-stack.remote",
  "name": "pocket-remote",
  "title": "Pocket Remote",
  "version": "0.1.0",
  "engine": {
    "capabilities": {
      "requires": ["input.touch", "text.glyphs.baked"]
    }
  },
  "app": {
    "entry": "apps/pocket-remote/main.tsx",
    "output": "pocket-remote-main",
    "framework": "solid",
    "viewport": {
      "fixed": {
        "logical": [480, 320],
        "presentation": "native"
      }
    }
  }
}
