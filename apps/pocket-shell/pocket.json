{
  "$schema": "https://pocketjs.dev/schema/pocket-2.json",
  "pocket": 2,
  "id": "dev.pocket-stack.pocket-shell",
  "name": "pocketjs-pocket-shell",
  "title": "PocketJS: Pocket Shell",
  "version": "0.1.0",
  "engine": {
    "capabilities": {
      "requires": [
        "text.glyphs.baked",
        "input.buttons",
        "display.auxiliary",
        "input.touch.auxiliary"
      ],
      "enhances": [
        "input.analog.left"
      ]
    }
  },
  "app": {
    "entry": "apps/pocket-shell/main.tsx",
    "output": "pocketshell-main",
    "framework": "solid",
    "surfaces": {
      "auxiliary": {
        "fixed": {
          "logical": [320, 240],
          "presentation": "native"
        }
      }
    },
    "viewport": {
      "fixed": {
        "logical": [400, 240],
        "presentation": "native"
      }
    }
  }
}
